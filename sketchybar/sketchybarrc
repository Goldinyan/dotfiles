#!/usr/bin/env bash

sketchybar --hotload on

# --- KODA PALETTE ---
FG="0xffb0b0b0"
DIM="0xff474747"
LINE="0xff272727"
KEYWORD="0xff777777"
EMPHASIS="0xffffffff"

# --- GLOBAL BAR CONFIG (TRANSPARENT) ---
sketchybar --bar \
  height=32 \
  position=top \
  color=0x00000000 \
  shadow=off \
  padding_left=12 \
  padding_right=12 \
  margin=0 \
  corner_radius=0

# --- DEFAULTS (SCHRIFTGRÖSSE +2) ---
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
  icon.color=$DIM \
  label.font="JetBrainsMono Nerd Font:Regular:14.0" \
  label.color=$FG \
  padding_left=8 \
  padding_right=8

# --- MODULES LEFT ---

# 1. Spaces (1 bis 5) mit Auto-Highlighting & Yabai-Window-Icons
for i in {1..5}; do
  sketchybar --add space space.$i left \
             --set space.$i space=$i \
             icon=$i \
             icon.color=$DIM \
             icon.highlight_color=$EMPHASIS \
             icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
             label.font="sketchybar-app-font:Regular:14.0" \
             label.color=$DIM \
             label.highlight_color=$EMPHASIS \
             padding_left=4 \
             padding_right=4 \
             script='
               if [ "$SELECTED" = "true" ]; then
                 sketchybar --set $NAME icon.highlight=on label.highlight=on
               else
                 sketchybar --set $NAME icon.highlight=off label.highlight=off
               fi

               if command -v yabai &>/dev/null; then
                 APPS=$(yabai -m query --windows --space $SID 2>/dev/null | jq -r ".[].app" | sort -u)
                 ICON_STR=""

                 if [ -f "$HOME/.config/sketchybar/plugins/icon_map.sh" ]; then
                   source "$HOME/.config/sketchybar/plugins/icon_map.sh"
                   while IFS= read -r app; do
                     [ -z "$app" ] && continue
                     icon_map "$app"
                     ICON_STR+="$ICON_MAP "
                   done <<< "$APPS"
                 fi

                 sketchybar --set $NAME label="$ICON_STR"
               fi
             ' \
             --subscribe space.$i space_change front_app_switched space_windows_change
done

sketchybar --add item sep1 left \
           --set sep1 icon="│" icon.color=$LINE label.drawing=off

sketchybar --add item weather left \
           --set weather update_freq=1800 \
           icon.drawing=off \
           script='
             WEATHER=$(curl -s "wttr.in/Brünen?format=%t+%c")
             if [ -n "$WEATHER" ]; then
               sketchybar --set weather label="$WEATHER"
             else
               sketchybar --set weather label="N/A"
             fi
           '

# --- MODULES RIGHT ---

# 3. Uhrzeit & Datum (Ohne Icon)
sketchybar --add item clock right \
           --set clock update_freq=10 \
           icon.drawing=off \
           script="sketchybar --set clock label=\"\$(date +'%a %d %b  %H:%M')\""

# 4. Kopfhörer Status (Bluetooth / Output Check)
sketchybar --add item audio right \
           --set audio update_freq=5 \
           icon="󰋋" \
           label.drawing=off \
           script='
             DEVICES=$(system_profiler SPAudioDataType 2>/dev/null)
             if echo "$DEVICES" | grep -qiE "headphone|airpods|headset"; then
               sketchybar --set audio icon.color=0xffffffff drawing=on
             else
               sketchybar --set audio drawing=off
             fi
           '

# 5. Aktive App (Ganz rechts platziert)
sketchybar --add item title right \
           --set title icon.drawing=off \
           label.color=$EMPHASIS \
           label.font="JetBrainsMono Nerd Font:Medium:14.0" \
           script="sketchybar --set title label=\"\$INFO\"" \
           --subscribe title front_app_switched

sketchybar --update
