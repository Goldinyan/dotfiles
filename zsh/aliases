# ========================================================================
# GIT ALIASES
# ========================================================================

# base git command
alias g='git'

# stage changes in current directory
alias ga='git add .'

# stage all changes across the entire repository
alias gaa='git add --all'

# commit staged changes with a message
alias gc='git commit -m'

# add staged changes to the last commit
alias gca='git commit --amend'

# show working directory and staging area status
alias gs='git status'

# push local commits to remote repository
alias gp='git push'

# safely force push without overwriting remote work
alias gpf='git push --force-with-lease'

# fetch and merge changes from remote repository
alias gl='git pull'

# show unstaged file modifications
alias gd='git diff'

# switch branches or restore working tree files
alias gco='git checkout'

# create and switch to a new branch
alias gcb='git checkout -b'

# list local branches
alias gb='git branch'

# display commit history as a concise graph
alias glog='git log --oneline --graph --decorate'

# ========================================================================
# COMBINED GIT WORKFLOWS
# ========================================================================

# pull remote changes and rebase local commits on top
alias gup='git pull --rebase'

# update last commit with staged files and force push safely
alias gcp='git commit --amend --no-edit && git push --force-with-lease'

# stage current directory commit with message and push
gcap() {
  git add . && git commit -m "$1" && git push
}

# stage entire repo commit with message and push
gcaap() {
  git add --all && git commit -m "$1" && git push
}

# commit tracked modifications with message and push, not new bc they are not tracked
gcpn() {
  git commit -am "$1" && git push
}

