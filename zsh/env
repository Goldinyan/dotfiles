#!/usr/bin/env bash

# Base Environment Settings
export TRANSPARENT=true
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export PAGER="less"
export GOPATH="$HOME/go"

# PATH Configurations
if [ -d "$HOME/.config/bin" ]; then
  export PATH="$(find "$HOME/.config/bin" -type d | paste -sd: -):$PATH"
fi

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.config/fzf/bin:$PATH"
export PATH="$GOPATH/bin:$PATH"
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# Editor & Pager Settings
export EDITOR="nvim"
export VISUAL="$EDITOR"
export MANPAGER="nvim +Man!"
export MANWIDTH=999

# Shell & Tool Options
export SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '
export WORDCHARS=${WORDCHARS//[\/]}
export LESS="-R -M -i -j5"
export RANGER_LOAD_DEFAULT_RC=FALSE
export EZA_ICON_SPACING=2

# Tool Themes (Uses Terminal Colors instead of Monokai/Arctic)
export BAT_THEME="base16"

# GNU Global (gtags)
export GTAGSLABEL='native-pygments'
if [ -d /opt/homebrew/Cellar/global ]; then
  conf_path=(/opt/homebrew/Cellar/global/*/share/gtags/gtags.conf(N))
  [ ${#conf_path} -gt 0 ] && export GTAGSCONF="${conf_path[1]}"
fi

# Exclude Rules for fd and ripgrep
export EXCLUDE=".git,.Trash,.vscode,.cache,.local,.DS_Store,Library,Music,Movies,Pictures,karabiner/automatic_backups,.zsh_sessions,Downloads/z"
FD_EXCLUDE=""
RG_EXCLUDE=""
while IFS=',' read -d ',' item; do
  FD_EXCLUDE+="--exclude '$item' "
  RG_EXCLUDE+="-g '!$item' "
done <<< "$EXCLUDE,"
export FD_EXCLUDE=${FD_EXCLUDE% }
export RG_EXCLUDE=${RG_EXCLUDE% }
