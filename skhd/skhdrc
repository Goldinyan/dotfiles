# -- Focus Windows --
# Change focus between windows in the current stack
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - p : yabai -m window --focus east

# -- Resize Windows --

# Versuche den linken Rand nach links zu schieben, falls das nicht geht (am Rand), ziehe den rechten Rand nach links.
alt + shift - h : yabai -m window --resize left:-20:0 || yabai -m window --resize right:-20:0

# Versuche den unteren Rand nach unten zu schieben, falls am Rand, ziehe den oberen Rand nach unten.
alt + shift - j : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20

# Versuche den oberen Rand nach oben zu schieben, falls am Rand, ziehe den unteren Rand nach oben.
alt + shift - k : yabai -m window --resize top:0:-20 || yabai -m window --resize bottom:0:-20

# Versuche den rechten Rand nach rechts zu schieben, falls am Rand, ziehe den linken Rand nach rechts.
alt + shift - l : yabai -m window --resize right:20:0 || yabai -m window --resize left:20:0

# -- Move Windows --
# Swap the position of the active window
shift + cmd - h : yabai -m window --swap west
shift + cmd - j : yabai -m window --swap south
shift + cmd - k : yabai -m window --swap north
shift + cmd - l : yabai -m window --swap east

# -- Layout Management --
# Toggle zoom (make one window full screen)
alt - f : yabai -m window --toggle zoom-parent

# Toggle split type (horizontal/vertical)
alt - e : yabai -m window --toggle split

# Toggle float and grid layout (4x4 grid, window takes up 2x2 cells)
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# -- Restart Services --
# Quickly reload configs after making changes
shift + alt - r : yabai --restart-service; skhd --restart-service

# Öffnet dmenu mit deinen installierten Apps (angepasst an dein Koda-Theme)
cmd + shift - return : mdfind "kMDItemContentType == 'com.apple.application-bundle'" | xargs -I {} basename "{}" | sed 's/\.app$//' | sort -f | dmenu -i -fn "JetBrainsMono Nerd Font:size=14" -nb "#101010" -nf "#b0b0b0" -sb "#272727" -sf "#b0b0b0" | xargs -I {} open -a "{}"


# open kitty
cmd - return : open -na /Applications/Kitty.app

# Close all Kitty instances
cmd + shift - q : killall kitty

