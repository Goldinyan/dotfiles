#!/usr/bin/env sh

# ==============================================================================
# 1. JANKYBORDERS INITIALISIERUNG
# ==============================================================================
killall borders 2>/dev/null

# Funktion, um borders dynamisch mit dem richtigen Ecken-Radius zu starten
# Standard: Eckiges Square-Design mit Radius 0 für Kitty
start_borders() {
    borders active_color=0xfff2f2f2 \
            inactive_color=0xff333333 \
            width=3.0 \
            flash_duration=0.2 \
            hidpi=on \
            style=square \
            radius=0.0 &
}

start_borders

# ==============================================================================
# 2. GLOBAL LAYOUT RULES
# ==============================================================================
yabai -m config layout bsp
yabai -m config window_placement second-child

# Padding Adjustments
yabai -m config top_padding 36
yabai -m config bottom_padding 16
yabai -m config left_padding 16
yabai -m config right_padding 16
yabai -m config window_gap 16

# Corner Flattening & Shadow Overrides
yabai -m config window_opacity off
yabai -m config window_shadow off
yabai -m config window_border off

# ==============================================================================
# 3. MOUSE SETTINGS (Fn-Taste steuert Floating Windows)
# ==============================================================================
yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier fn
yabai -m config mouse_action move
yabai -m config mouse_drop_action resize

# ==============================================================================
# 4. WINDOW RULES
# ==============================================================================
yabai -m rule --add app="^Zen Browser$" sub-layer=normal manage=on
yabai -m rule --add app="^qutebrowser$" manage=on
yabai -m rule --add app="^Obsidian$" manage=on window_shadow=off

yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Terminal$" manage=off

# ==============================================================================
# 5. DYNAMISCHES ECKEN-SIGNAL (Der Obsidian/Kitty-Switch)
# ==============================================================================
# Jedes Mal, wenn das Fenster gewechselt (fokussiert) wird, checken wir die App:
# Wenn es Kitty ist -> Radius 0 (eckig) | Wenn nicht -> Radius 12 (rund für Obsidian & Co.)
yabai -m signal --add event=window_focused action='
    curr_app=$(yabai -m query --windows --window | jq -r ".app")
    if [ "$curr_app" = "kitty" ]; then
        borders radius=0.0 style=square
    else
        borders radius=12.0 style=round
    fi
'
